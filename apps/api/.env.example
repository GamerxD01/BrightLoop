# Copy to .env and adjust.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/brightloop
# Long random string; generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
APP_URL=http://localhost:5173
LOG_LEVEL=info
# Optional SMTP. Without it, reset links and invoice emails are written to the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Brightloop Billing <billing@brightloop.test>"
# Daily jobs (billing, starting subscriptions, renewal notices, overdue reminders).
AUTOMATION_ENABLED=true
AUTOMATION_INTERVAL_MINUTES=10
